<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Personix.EventAggregation</PackageId>
    <AssemblyName>Personix.EventAggregation</AssemblyName>
    <RootNamespace>Personix.EventAggregation</RootNamespace>
    <Version>1.1.0</Version>
    <PackageReleaseNotes>1.1.0 — adds a net11.0 target alongside net10.0. No API change.</PackageReleaseNotes>
    <Authors>Pavel Kudrna</Authors>
    <Company>Personix</Company>
    <Product>Personix.EventAggregation</Product>
    <Description>In-process domain event aggregator. Publishing an event persists it, dispatches it to webhook subscribers, and invokes in-memory handlers, with the trace context carried on the persisted record so an event can be correlated back to the request that caused it.</Description>
    <Copyright>Copyright (c) 2026 Personix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/personix-org/EventAggregation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/personix-org/EventAggregation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>events;domain-events;event-aggregator;webhooks;pub-sub;cqrs</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Personix.Tracing" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

</Project>
